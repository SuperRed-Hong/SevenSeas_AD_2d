# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/*

# Memory captures
[Mm]emoryCaptures/

# Asset store tools
[Aa]ssets/AssetStoreTools*

# Visual Studio / Rider / IDE
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig
*.slnx
# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Unity crash / profiler
sysinfo.txt
*.stackdump

# Builds and packages
*.apk
*.aab
*.unitypackage
*.app
.utmp/

# Addressables build data
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
UserSettings/Layouts/CurrentMaximizeLayout.dwlt

# WebGL build published to GitHub Pages.
# Unity names its output folder "Build", which the [Bb]uild/ rule above would
# swallow. These negations must stay last so they win. A directory has to be
# re-included before anything inside it can be.
!webgl-dist/
!webgl-dist/Build/
!webgl-dist/**

# Regenerated from index.html on demand
docs/motion-diagnostics/*.zip
