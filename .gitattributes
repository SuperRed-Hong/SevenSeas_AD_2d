# Normalize text files
* text=auto

# Unity text-serialized assets
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.asset text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.playable text eol=lf
*.mask text eol=lf
*.physicsMaterial2D text eol=lf
*.physicsMaterial text eol=lf
*.renderTexture text eol=lf
*.spriteatlas text eol=lf
*.terrainlayer text eol=lf
*.preset text eol=lf
*.inputactions text eol=lf
*.lighting text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.cs text eol=lf

# Git LFS for large/binary assets
*.psd filter=lfs diff=lfs merge=lfs -text
